# Workplace Navigator - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# APPLICATION
# ===========================================
APP_NAME="Workplace Navigator"
APP_VERSION="0.1.0"
DEBUG=true

# ===========================================
# DATABASE (PostgreSQL + PostGIS)
# ===========================================
# For local development:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/workplace_nav

# For Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/workplace_nav

DATABASE_ECHO=false

# ===========================================
# OPENROUTER AI
# ===========================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Available models:
# - anthropic/claude-3.5-sonnet (recommended)
# - openai/gpt-4o
# - anthropic/claude-3-opus
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ===========================================
# AZURE MAPS
# ===========================================
# Get these from Azure Portal > Azure Maps Account
AZURE_MAPS_CLIENT_ID=your_azure_maps_client_id
AZURE_MAPS_SUBSCRIPTION_KEY=your_azure_maps_subscription_key

# Indoor Maps Configuration
# Get these from Azure Maps Creator after uploading your floor plans
AZURE_MAPS_TILESET_ID=your_tileset_id
AZURE_MAPS_STATESET_ID=your_stateset_id

# ===========================================
# CORS
# ===========================================
# Allowed origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]
